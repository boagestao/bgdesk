# Copie os campos necessários para .env (ignorado pelo Git).
# Certificado Developer ID Application, com chave privada, fora do repositório.
MACOS_P12_FILE="/caminho/DeveloperId.p12"
MACOS_P12_PASSWORD=""
MACOS_TEAM_ID="3Z7C3Q7NMT"

# O perfil local do Keychain não existe nos runners. Para Actions, configure
# uma senha específica de app da Apple, nunca a senha principal da conta.
MACOS_NOTARY_APPLE_ID=""
MACOS_NOTARY_PASSWORD=""

# O helper faz checkout do config e salva os arquivos desktop no Secret
# BGDESK_CONFIG_ARCHIVE. Não é necessário preencher um token do config.
# Alternativa opcional: BGDESK_CONFIG_TOKEN com Contents / Read-only,
# executando o helper com --skip-config-archive.

# Token S3 do R2 restrito ao bucket de distribuição (Object Read & Write).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_BUCKET=""
# Domínio HTTPS público do bucket, sem / no final. Torna-se parte do aplicativo.
R2_PUBLIC_ORIGIN="https://download.bgdesk.com"

# A chave Ed25519 de updates é lida de ~/.config/bgdesk/update-signing.json.
# Enviar ao GitHub sem imprimir valores:
# python3 scripts/ci/setup-github-secrets.py --apply
